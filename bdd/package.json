{
  "name": "starface-agentops-bdd",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/**/*.ts' --import 'steps/**/*.ts' --format progress --format html:reports/cucumber.html",
    "test:headed": "HEADED=1 node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/**/*.ts' --import 'steps/**/*.ts' --format progress --format html:reports/cucumber.html"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6"
  }
}
